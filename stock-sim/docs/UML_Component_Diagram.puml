@startuml Stock Trading Simulator - Component Diagram

!define RECTANGLE class

package "Stock Trading Simulator" {
  
  package "Game Logic Layer" {
    component [Game Manager] as GM {
      port "Game State" as GSPort
      port "Action Handler" as AHPort
      port "Tutorial System" as TSPort
    }
    
    component [Portfolio Manager] as PM {
      port "Holdings" as HPort
      port "Transaction" as TPort
    }
    
    component [Stock Data Model] as SDM {
      port "Price Data" as PDPort
      port "OHLC Access" as OHLCPort
    }
  }
  
  package "Visualization Layer" {
    component [Candlestick Chart] as Chart {
      port "Data Input" as DIPort
      port "Rendering" as RPort
    }
    
    component [UI Components] as UI {
      port "Display Update" as DUPort
      port "User Input" as UIPort
    }
  }
  
  package "Data Processing" {
    component [CSV Parser] as Parser {
      port "File Input" as FIPort
      port "Data Output" as DOPort
    }
    
    database "Historical\nStock Data" as CSV {
    }
  }
  
  package "Dialog System" {
    component [Tutorial Dialogs] as Tutorials {
      port "Tutorial Content" as TCPort
    }
    
    component [Transaction Dialogs] as Dialogs {
      port "User Confirmation" as UCPort
    }
  }
  
  package "Godot Engine" {
    component [Scene Tree] as SceneTree
    component [Rendering Engine] as Renderer
    component [Input System] as Input
    component [UI System] as UISystem
  }
}

' Connections within Game Logic Layer
GM GSPort -- HPort PM : manages
GM AHPort -- TPort PM : executes transactions
GM -- PDPort SDM : reads prices
Chart DIPort -- OHLCPort SDM : displays data

' Connections to Visualization Layer
GM -- DUPort UI : updates
UI UIPort -- AHPort GM : sends actions
GM -- DIPort Chart : provides data
Chart RPort -- Renderer : renders

' Data Processing connections
CSV FIPort -- Parser : reads
Parser DOPort -- PDPort SDM : populates

' Dialog System connections
GM TSPort -- TCPort Tutorials : triggers
GM -- UCPort Dialogs : creates
Dialogs -- UIPort UI : displays

' Godot Engine connections
GM -- SceneTree : node hierarchy
UI -- UISystem : labels, buttons
Chart -- Renderer : custom drawing
Input -- UIPort UI : button clicks

note right of GM
  **Game Manager**
  Core controller that orchestrates:
  - Game state (quarters, cash)
  - Player actions (buy/sell/hold)
  - UI updates
  - Tutorial system
  - Win/lose conditions
end note

note right of Chart
  **Candlestick Chart**
  Visualization component:
  - Renders 12-14 weekly candles
  - OHLC data with wicks/bodies
  - Dynamic scaling
  - Grid and price labels
  - Color coding (green/red)
end note

note bottom of Parser
  **CSV Parser**
  Preprocesses historical data:
  - Reads 250 days of prices
  - Groups into 50 weeks
  - Splits into 4 quarters
  - Calculates OHLC aggregates
  - Outputs Godot-ready format
end note

note right of SDM
  **Stock Data Model**
  Holds market data:
  - 3 stocks (AAPL, MSFT, TSLA)
  - 4 quarters each
  - 12-14 weekly candles per quarter
  - Full OHLC data per candle
end note

note left of PM
  **Portfolio Manager**
  Tracks player assets:
  - Cash balance
  - Stock holdings
  - Transaction validation
  - Value calculation
end note

@enduml
